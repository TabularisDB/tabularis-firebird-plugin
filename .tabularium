{
  "name": "firebird",
  "version": "0.2.0-beta.6",
  "connection_metadata": true,
  "description": "Tabularis driver plugin for Firebird",
  "kind": "driver",
  "engine": "firebird",
  "paradigms": ["relational"],
  "default_port": 3050,
  "default_username": "SYSDBA",
  "executable": "firebird-plugin",
  "connection_fields": {
    "database": {
      "label": "Database path or alias (on the Firebird server)",
      "placeholder": "C:\\data\\example.fdb or configured server alias"
    }
  },
  "capabilities": {
    "schemas": false,
    "views": true,
    "routines": true,
    "triggers": true,
    "file_based": false,
    "folder_based": false,
    "no_connection_required": false,
    "connection_string": false,
    "supports_ssl": false,
    "identifier_quote": "\"",
    "auto_increment_keyword": "GENERATED BY DEFAULT AS IDENTITY",
    "sql_syntax": {"extends":"generic","boolean_literals":"keywords","nested_block_comments":true},
    "alter_primary_key": false,
    "alter_column": true,
    "create_foreign_keys": true,
    "manage_tables": true,
    "column_comments": true,
    "drop_table_sql": true,
    "readonly": false,
    "explain": true,
    "table_query_templates": true
  },
  "settings": [
    {"key":"role","label":"SQL role","type":"string","default":"","description":"Optional SQL role. Quote case-sensitive names, for example \"Reader\". Per-connection extra.role overrides this default."},
    {"key":"charset","label":"Connection character set","type":"select","options":["UTF8","WIN1250","WIN1251","WIN1252","WIN1253","WIN1254","WIN1256","WIN1257","WIN1258","ISO8859_1","ISO8859_2","ISO8859_3","ISO8859_4","ISO8859_5","ISO8859_6","ISO8859_7","ISO8859_13","ASCII","KOI8R","KOI8U","EUCJ_0208","BIG_5"],"default":"UTF8","description":"Strict text encoding; unsupported characters produce an error. Per-connection extra.charset overrides this default. Text BLOB output is converted to UTF-8."},
    {"key":"wire_crypt","label":"Wire encryption","type":"select","options":["required","enabled","disabled"],"default":"required","description":"Required rejects unencrypted connections. Enabled also permits an unencrypted server."},
    {"key":"allow_arc4","label":"Allow Arc4 for Firebird 3 compatibility","type":"boolean","default":true,"description":"ChaCha64 and ChaCha are preferred. Disable to reject servers offering only Arc4."},
    {"key":"query_timeout_secs","label":"Query timeout in seconds (0 = unlimited)","type":"number","default":0},
    {"key":"max_result_rows","label":"Maximum buffered result rows","type":"number","default":100000},
    {"key":"max_result_mib","label":"Maximum buffered result size (MiB)","type":"number","default":64},
    {"key":"max_blob_mib","label":"Maximum BLOB size per cell (MiB)","type":"number","default":8}
  ],
  "data_types": [
    {"name":"SMALLINT","category":"numeric","requires_length":false,"requires_precision":false,"supports_auto_increment":true},
    {"name":"INTEGER","category":"numeric","requires_length":false,"requires_precision":false,"supports_auto_increment":true},
    {"name":"BIGINT","category":"numeric","requires_length":false,"requires_precision":false,"supports_auto_increment":true},
    {"name":"FLOAT","category":"numeric","requires_length":false,"requires_precision":false},
    {"name":"DOUBLE PRECISION","category":"numeric","requires_length":false,"requires_precision":false},
    {"name":"NUMERIC","category":"numeric","requires_length":false,"requires_precision":true},
    {"name":"DECIMAL","category":"numeric","requires_length":false,"requires_precision":true},
    {"name":"CHAR","category":"string","requires_length":true,"requires_precision":false,"default_length":"1"},
    {"name":"VARCHAR","category":"string","requires_length":true,"requires_precision":false,"default_length":"255"},
    {"name":"BOOLEAN","category":"other","requires_length":false,"requires_precision":false},
    {"name":"DATE","category":"date","requires_length":false,"requires_precision":false},
    {"name":"TIME","category":"date","requires_length":false,"requires_precision":false},
    {"name":"TIMESTAMP","category":"date","requires_length":false,"requires_precision":false},
    {"name":"BLOB SUB_TYPE TEXT","category":"string","requires_length":false,"requires_precision":false},
    {"name":"BLOB SUB_TYPE BINARY","category":"binary","requires_length":false,"requires_precision":false}
  ]
}
