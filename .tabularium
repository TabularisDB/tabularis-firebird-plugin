{
  "name": "firebird",
  "version": "0.1.0",
  "description": "Tabularis driver plugin for Firebird",
  "kind": "driver",
  "engine": "firebird",
  "paradigms": ["relational"],
  "default_port": 3050,
  "default_username": "SYSDBA",
  "executable": "firebird-plugin",
  "connection_fields": {
    "database": {
      "label": "Database path or alias (on the Firebird server)",
      "placeholder": "C:\\data\\example.fdb or configured server alias"
    }
  },
  "capabilities": {
    "schemas": false,
    "views": true,
    "routines": true,
    "file_based": false,
    "folder_based": false,
    "no_connection_required": false,
    "connection_string": false,
    "supports_ssl": false,
    "identifier_quote": "\"",
    "alter_primary_key": false,
    "alter_column": false,
    "create_foreign_keys": false,
    "manage_tables": false,
    "readonly": true,
    "table_query_templates": true,
    "query_timeout": true
  },
  "settings": [
    {"key":"max_result_rows","label":"Maximum buffered result rows","type":"number","default":100000},
    {"key":"max_result_mib","label":"Maximum buffered result size (MiB)","type":"number","default":64},
    {"key":"max_blob_mib","label":"Maximum BLOB size per cell (MiB)","type":"number","default":8}
  ],
  "data_types": [
    {
      "name": "INTEGER",
      "category": "numeric",
      "requires_length": false,
      "requires_precision": false
    },
    {
      "name": "TEXT",
      "category": "string",
      "requires_length": false,
      "requires_precision": false
    }
  ]
}
